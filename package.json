{
  "name": "xrpl-message-verify-workspace",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "gen-fixtures": "pnpm --filter xrpl-message-verify exec tsx scripts/gen-fixtures.ts",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.1",
    "@changesets/changelog-github": "1.0.0",
    "@eslint/js": "10.0.1",
    "eslint": "10.9.1",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0"
  }
}
