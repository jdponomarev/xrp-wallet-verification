{
  "name": "xrpl-message-verify",
  "version": "0.1.0",
  "description": "Verify XRP Ledger signed messages and Xaman SignIn blobs: secp256k1 and ed25519, address derivation, challenge envelope.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jdponomarev/xrp-wallet-verification.git",
    "directory": "packages/core"
  },
  "homepage": "https://jdponomarev.github.io/xrp-wallet-verification/",
  "bugs": "https://github.com/jdponomarev/xrp-wallet-verification/issues",
  "keywords": [
    "xrpl",
    "xrp",
    "ripple",
    "signature",
    "verify",
    "sign-message",
    "xaman",
    "signin",
    "secp256k1",
    "ed25519"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "attw": "attw --pack ."
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "ripple-address-codec": "5.0.1",
    "ripple-binary-codec": "2.10.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@types/node": "26.4.1",
    "ripple-keypairs": "3.0.0",
    "tsup": "8.5.1",
    "tsx": "4.23.13",
    "verify-xrpl-signature": "9.2.0",
    "vitest": "4.1.11"
  }
}
